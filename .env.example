# Telegram (заявки с сайта -> админ/чат)
TELEGRAM_SITE_BOT_TOKEN=
TELEGRAM_SITE_CHAT_ID=

# Админка (доступ к /admin/exchange и /admin/orders)
ADMIN_PASSWORD=change_me

# ── Мини-приложение в Telegram ─────────────────────────────

# База данных для заявок, этапов оплаты, чата, витрины и запросов.
# Без неё мини-приложение открывается, но заявки и витрина недоступны.
DATABASE_URL=postgres://user:password@localhost:5432/alipayfast

# Бот мини-приложения: токен из @BotFather
TELEGRAM_MINI_APP_BOT_TOKEN=
# Если панель оператора открывается из ДРУГОГО бота, добавьте его токен здесь:
# подпись initData проверяется по всем токенам (этот, мини-аппа, сайта).
TELEGRAM_ADMIN_BOT_TOKEN=
# Ваш личный Telegram ID — бот пишет сюда о новых заявках и запросах
ADMIN_USER_ID=
# Секрет для вебхука (любая строка, передаётся Telegram при установке)
TELEGRAM_WEBHOOK_SECRET=change_me
# Публичный адрес вебхука, если его нельзя вывести из запроса
TELEGRAM_WEBHOOK_URL=

# Кнопка «Открыть комнату сделки» в уведомлениях:
# https-адрес мини-приложения — кнопка откроет его прямо в Telegram
MINI_APP_URL=
# запасная ссылка на бота, если MINI_APP_URL не задан
TELEGRAM_MINI_APP_LINK=https://t.me/AlipayFastBot/alipayfast

# Панель оператора (только для ADMIN_USER_ID): https-адрес /admin/tg
# или /admin-mini-app — это одно и то же приложение.
# По команде /admin в боте оператор получит кнопку входа.
ADMIN_MINI_APP_URL=

# Кто из операторов представляется клиенту в приветствии и уведомлениях
ADMIN_DISPLAY_NAME=alipayfast
ADMIN_CONTACT=@whaledator

# Адрес Telegram Bot API. Менять не нужно, используется для локальных тестов
TELEGRAM_API_BASE=

# ── Доступ к Telegram с сервера в РФ ───────────────────────
# VLESS/XTTP сам не является HTTP-прокси: на сервере поднимается локальный
# клиент (xray/sing-box), который слушает 127.0.0.1 и выпускает трафик через
# ваш VLESS-сервер. Здесь указывается его локальный адрес:
#   http://127.0.0.1:10809    — HTTP(S)-прокси
#   socks5://127.0.0.1:10808 — SOCKS5
# Если пусто — запросы к Telegram идут напрямую.
TELEGRAM_PROXY_URL=

# Курс для подсчёта выгоды в витрине и в ответах бота
SHOWCASE_EXCHANGE_RATE=12.5

# Загрузка чеков и фото товаров
UPLOADS_DIR=./public/uploads
UPLOADS_BASE_URL=/uploads
