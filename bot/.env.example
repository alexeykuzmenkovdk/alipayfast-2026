# ── Бот и чат ─────────────────────────────────────────────
# Токен бота-постера: он публикует и правит сообщение в группе.
# Команды принимает отдельный бот (CONTROL_BOT_TOKEN, см. ниже).
BOT_TOKEN=
# ID группы/канала, куда публикуем (например, -1001234567890)
POST_CHAT_ID=
# Ваш Telegram ID — используется, если CONTROL_ADMIN_IDS не задан
ADMIN_USER_ID=

# ── Расписание ────────────────────────────────────────────
# Ежедневный пост по Владивостоку (UTC+10)
POST_HOUR=16
POST_MINUTE=0

# ── Источник курса ────────────────────────────────────────
# API сайта: бот берёт готовый ранжир, поэтому совпадает с сайтом и
# мини-приложением, включая надбавку из /admin/exchange.
SITE_API_URL=http://127.0.0.1:3000/api/exchange-rate
# Как часто сверять последнее сообщение с сайтом (секунды)
SYNC_INTERVAL_SEC=300

# ── Telegram через VLESS ──────────────────────────────────
# Локальный клиент xray/sing-box: socks5://127.0.0.1:10809 (или http://...).
# Можно указать socks5h:// как в .env сайта — бот сам приведёт схему к socks5.
TELEGRAM_PROXY_URL=socks5://127.0.0.1:10809
# Только для локальных тестов; на проде оставьте пустым
TELEGRAM_API_BASE=

# ── Ссылки в сообщении ────────────────────────────────────
SITE_URL=https://alipayfast.ru
BOT_USERNAME=@alipayfastbot
ADMIN_USERNAME=@whaledator
MINI_APP_URL=https://t.me/AlipayFastBot/alipayfast

# ── Цитаты и состояние ────────────────────────────────────
# text.txt лежит рядом с ботом (нумерованные строки, идут по кругу)
WISDOM_FILE=text.txt
# subscribers.db хранит номер цитаты и последнее сообщение.
# Скопируйте старую БД, чтобы продолжить последовательность цитат.
DB_PATH=subscribers.db

# ── Локальное управление (curl с сервера) ─────────────────
# Придумайте длинный токен. Пусто — HTTP-управление выключено.
CONTROL_TOKEN=
CONTROL_PORT=8081

# ── Управление через отдельного бота ──────────────────────
# Токен @alipayvdkbot из @BotFather. Должен отличаться от BOT_TOKEN и от
# токенов ботов сайта (у них на сервере вебхук — polling бы его сломал).
# Команды: /status, /sync, /post_today.
CONTROL_BOT_TOKEN=
# Кому разрешены команды: Telegram ID через запятую. Пусто — берётся ADMIN_USER_ID.
CONTROL_ADMIN_IDS=
